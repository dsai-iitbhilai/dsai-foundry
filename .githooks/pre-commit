#!/usr/bin/env sh
# DSAI Foundry pre-commit hook
# Automatically validates staged files before creating a commit.

if command -v python3 >/dev/null 2>&1; then
  PYTHON_CMD=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON_CMD=python
elif command -v py >/dev/null 2>&1; then
  PYTHON_CMD=py
else
  echo "❌ Error: Python interpreter not found in PATH."
  exit 1
fi

$PYTHON_CMD foundry.py check --staged
RESULT=$?

if [ $RESULT -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked by DSAI Foundry pre-commit guardrail."
  echo "Please fix the reported issues before committing."
  echo ""
  exit 1
fi

exit 0
